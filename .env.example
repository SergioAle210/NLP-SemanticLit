# Copiar a .env y completar. .env está en .gitignore: NUNCA commitear credenciales.

# --- LLM (Claude) ---
ANTHROPIC_API_KEY=
GAMERAG_LLM_MODEL=claude-haiku-5-5

# --- Rutas (relativas a la raíz del repo; en Docker se montan como volúmenes) ---
GAMERAG_DATA_DIR=data
GAMERAG_INDEX_DIR=data/index
GAMERAG_STATE_DB=state/gamerag.sqlite3

# --- Recuperación semántica (requiere `uv sync --extra semantic`) ---
GAMERAG_EMBEDDING_MODEL=e5-small-multi
GAMERAG_MODELS_DIR=models

# --- Operación ---
GAMERAG_LOG_LEVEL=INFO
