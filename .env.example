# Copiar a .env y completar. .env está en .gitignore: NUNCA commitear credenciales.

# --- LLM (Claude) ---
ANTHROPIC_API_KEY=
GAMERAG_LLM_MODEL=claude-haiku-5-5
# Control de costo (gamerag/llm.py). Tope del proyecto entero, acumulado entre corridas, en USD:
GAMERAG_LLM_BUDGET_USD=15
GAMERAG_LLM_RUN_BUDGET_USD=1
GAMERAG_LLM_MAX_TOKENS=1024
# Precios por millón de tokens: verificar en la consola de Anthropic
GAMERAG_LLM_PRICE_INPUT=0.10
GAMERAG_LLM_PRICE_OUTPUT=0.50
# true = solo caché (repetir evaluaciones y tests sin gastar)
GAMERAG_LLM_OFFLINE=false

# --- Rutas (relativas a la raíz del repo; en Docker se montan como volúmenes) ---
GAMERAG_DATA_DIR=data
GAMERAG_INDEX_DIR=data/index
GAMERAG_STATE_DB=state/gamerag.sqlite3

# --- Recuperación (ADR-0009). dense/hybrid requieren `uv sync --extra semantic` ---
GAMERAG_RETRIEVER=hybrid
GAMERAG_CHUNKER=structural
GAMERAG_EMBEDDING_MODEL=e5-small-multi
GAMERAG_MODELS_DIR=models
GAMERAG_QUERY_EXPANSION=true
GAMERAG_ROUTER=true
GAMERAG_TOP_K=5
GAMERAG_CANDIDATES=50

# --- Interfaz (Streamlit) ---
GAMERAG_API_URL=http://127.0.0.1:8000
GAMERAG_UI_DEFAULT_GAME=zelda1

# --- Operación ---
GAMERAG_LOG_LEVEL=INFO

# Generador: extractive (sin LLM) | haiku (degrada al extractivo si falla)
GAMERAG_GENERATOR=extractive
GAMERAG_USE_GRAPH=false
GAMERAG_EVIDENCE_EVAL=false
GAMERAG_MAX_REWRITES=1
GAMERAG_EVIDENCE_MODE=on_abstain
GAMERAG_PLANNER=false
GAMERAG_MEMORY_NOTES=false
GAMERAG_SPOILER_GATES=true
GAMERAG_SECONDARY_SEARCH=false
GAMERAG_SECONDARY_K=3

# Perfil: base (hibrido + extractivo, sin LLM) | full (grafo + Haiku + evaluador + segunda busqueda con indice
# mezclado; requiere ANTHROPIC_API_KEY, sin ella queda en base). Un campo fijado explicitamente gana al perfil.
GAMERAG_PROFILE=base
